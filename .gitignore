# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# Key material. Covers receipt signing keys from `changesafe keygen`: a
# committed private key silently invalidates every signature it ever made.
# Public keys are ignored too, deliberately — distributing one is a decision,
# so add it explicitly with `git add -f key.pub.pem` if you mean to.
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real values; the example template is allowed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/

# local tooling state (not part of the product)
.omc/
.claude/settings.local.json

# playwright-mcp browser session artifacts
/.playwright-mcp/

# built packages
packages/*/dist/
