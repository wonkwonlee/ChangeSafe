# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# Key material. Covers receipt signing keys from `changesafe keygen`: a
# committed private key silently invalidates every signature it ever made.
# Public keys are ignored too, deliberately — distributing one is a decision,
# so add it explicitly with `git add -f key.pub.pem` if you mean to.
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real values; the example template is allowed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/

# local orchestration runtime state (not part of the product). Keep generated
# state ignored at every depth, including nested worktrees. The root-level
# exceptions below are the only durable, human-authored Markdown allowlist.
.omc/
.omx/
.superpowers/

.worktrees/
.claude/settings.local.json

# local artifacts (not part of the product)
/artifacts/

# beads (bd) issue-tracker state. The Dolt database, its config, and the
# agent-tool wiring bd installs are per-machine runtime state, and beads syncs
# through its own git refs rather than through tracked files — committing
# .beads/issues.jsonl would version a passive export as if it were the source
# of truth. Contributors do not need bd to work on this repository; the
# workflow is documented in AGENTS.md.
/.beads/
/.agents/skills/beads/
/.codex/hooks.json

# playwright-mcp browser session artifacts
/.playwright-mcp/

# built packages
packages/*/dist/
# ...except the CLI bundle, which the GitHub Action executes directly. It is a
# build output living in git on purpose: a consumer's CI must not have to
# install this repository to run the gate. CI rebuilds it and fails if the
# committed bytes differ, so what ships is always the reviewed source.
!packages/cli/dist/
!packages/cli/dist/changesafe.js
