# ChangeSafe environment template. Copy to .env.local and fill in as needed.
# Never commit real values.
#
# All of this is optional. With no provider configured, ChangeSafe runs in
# replay mode using bundled fixtures — the full validation, gate, decision,
# and receipt pipeline, with no credential and no network. The deterministic
# gate never calls a model under any configuration.

# Which provider live mode should call: openai | anthropic | ollama.
# Leave unset to auto-select whichever hosted provider has a key below.
CHANGESAFE_PROVIDER=

# Server-only credentials. Read exclusively by server code; never sent to the
# browser, and never written to receipts, fixtures, or error messages.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional per-provider model overrides. Each defaults to that provider's
# current recommended model.
CHANGESAFE_OPENAI_MODEL=
CHANGESAFE_ANTHROPIC_MODEL=
CHANGESAFE_OLLAMA_MODEL=

# Ollama runs locally and needs no credential. Override only if it is not on
# the default host and port.
CHANGESAFE_OLLAMA_HOST=

# Optional. Valid only for OpenAI reasoning models; omitted by default because
# other models reject the parameter outright.
CHANGESAFE_OPENAI_REASONING_EFFORT=

# Optional base-URL overrides for gateways, proxies, or compatible endpoints.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# Optional. Per-client cap on live analyses through the app's API, which is
# unauthenticated by design. Default 10 per hour; 0 disables the cap. It is a
# speed bump (per-process memory, forwarded-header identity), not a defense —
# put auth or a proxy in front of a public live deployment.
CHANGESAFE_LIVE_RATE_LIMIT=
CHANGESAFE_LIVE_RATE_WINDOW_SECONDS=

# Optional. Set to 1 to enable the live smoke test (spends API credit and
# requires a configured provider). Normal test runs must leave this unset.
CHANGESAFE_LIVE_SMOKE=

# Optional. With the live smoke test enabled, also write a provenance-stamped
# capture for review before promoting it to a bundled replay fixture.
CHANGESAFE_CAPTURE_FIXTURE=
