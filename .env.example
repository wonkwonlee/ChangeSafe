# ChangeSafe environment template. Copy to .env.local and fill in as needed.
# Never commit real values.

# Server-only OpenAI API key. Optional: without it ChangeSafe runs in replay
# mode using bundled fixtures, which is the default judging path. The key is
# read exclusively by server code and is never sent to the browser.
OPENAI_API_KEY=

# Optional. Set to 1 to enable the live GPT-5.6 smoke test (spends API credit,
# requires OPENAI_API_KEY). Normal test runs must leave this unset.
CHANGESAFE_LIVE_SMOKE=
