{
  "name": "changesafe",
  "version": "0.1.0",
  "private": true,
  "description": "A deterministic airlock for AI-proposed infrastructure changes: AI proposes, pure policies validate, a human decides, simulation stays sandboxed.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonkwonlee/ChangeSafe.git"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:cli": "npm run build -w changesafe",
    "changesafe": "node packages/cli/dist/changesafe.js"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.23"
  },
  "workspaces": [
    "packages/*"
  ]
}
