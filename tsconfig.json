{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@changesafe/ai": ["./packages/ai/src/index.ts"],
      "@changesafe/core": ["./packages/core/src/index.ts"],
      "@changesafe/ledger": ["./packages/ledger/src/index.ts"],
      "@changesafe/server": ["./packages/server/src/index.ts"],
      "@changesafe/domain-network": ["./packages/domain-network/src/index.ts"],
      "@changesafe/domain-terraform": ["./packages/domain-terraform/src/index.ts"],
      "@changesafe/domain-kubernetes": ["./packages/domain-kubernetes/src/index.ts"],
      "@changesafe/domain-kubernetes/manifest-proposal": ["./packages/domain-kubernetes/src/manifest-proposal.ts"],
      "@changesafe/domain-kubernetes/offline": ["./packages/domain-kubernetes/src/offline.ts"],
      "@changesafe/kubernetes-collector": ["./packages/kubernetes-collector/src/index.ts"],
      "changesafe": ["./packages/cli/src/main.ts"],
      "changesafe/version": ["./packages/cli/src/version.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
