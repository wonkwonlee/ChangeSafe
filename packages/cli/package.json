{
  "name": "changesafe",
  "version": "0.4.0",
  "description": "Gate AI-proposed infrastructure changes from the terminal or CI: deterministic policies, honest exit codes, hashed receipts. The gate itself never calls a model.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "changesafe": "./dist/changesafe.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "terraform",
    "kubernetes",
    "policy",
    "guardrails",
    "ai-safety",
    "infrastructure",
    "ci",
    "cli"
  ],
  "homepage": "https://github.com/wonkwonlee/ChangeSafe#readme",
  "bugs": {
    "url": "https://github.com/wonkwonlee/ChangeSafe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonkwonlee/ChangeSafe.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "//": "The gate and workspace packages are bundled. The official Kubernetes client remains a runtime dependency loaded only by `kubernetes collect`; offline gate commands do not load it.",
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@changesafe/ai": "^0.4.0",
    "@changesafe/core": "^0.4.0",
    "@changesafe/domain-network": "^0.4.0",
    "@changesafe/domain-terraform": "^0.4.0",
    "@changesafe/ledger": "^0.4.0",
    "@changesafe/server": "^0.4.0",
    "esbuild": "^0.25.0",
    "typescript": "^5",
    "zod": "^4.4.3",
    "@changesafe/domain-kubernetes": "^0.4.0",
    "@changesafe/kubernetes-collector": "^0.4.0"
  }
}
