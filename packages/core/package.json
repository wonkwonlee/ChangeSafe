{
  "name": "@changesafe/core",
  "version": "0.2.0",
  "description": "The deterministic airlock engine: typed change proposals, pure safety policies, transactional decisions, and hashed receipts. Domain-agnostic.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "policy",
    "guardrails",
    "ai-safety",
    "infrastructure",
    "receipts",
    "zod"
  ],
  "homepage": "https://github.com/wonkwonlee/ChangeSafe#readme",
  "bugs": {
    "url": "https://github.com/wonkwonlee/ChangeSafe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonkwonlee/ChangeSafe.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/finish-package-build.mjs dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
